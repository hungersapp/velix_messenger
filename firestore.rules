rules_version = '2';

/**
 * Velix Messenger — Production Firestore Security Rules (Phase 1)
 *
 * Principles:
 * - Least privilege; default deny
 * - Auth secrets live only under users/{uid}/security/credentials
 * - Public profile fields may be read by authenticated users
 * - Pre-auth identity resolution uses usernames/ + velix_ids/ indexes (no secrets)
 *
 * IMPORTANT: Firestore cannot hide individual fields on a shared document.
 * Sensitive material MUST NOT be written to users/{uid}.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function uid() {
      return request.auth.uid;
    }

    /** Secret / internal fields that must never appear on users/{uid}. */
    function hasForbiddenUserSecrets() {
      return request.resource.data.keys().hasAny([
        'passwordVault',
        'recoverySecurityKey',
        'recoverySecurityKeyHash',
        'totpSecret'
      ]);
    }

    function isConversationParticipant() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants;
    }

    function isConversationParticipantOnCreate() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.participants;
    }

    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isParticipantOfConversation(conversationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && uid() in conversationData(conversationId).participants;
    }

    function otherDmParticipant(conversationId) {
      let parts = conversationData(conversationId).participants;
      return parts.size() == 2
        ? (parts[0] == uid() ? parts[1] : parts[0])
        : uid();
    }

    function isBlockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocked/$(a));
    }

    function isCallParticipant() {
      return isSignedIn()
        && (uid() == resource.data.callerId || uid() == resource.data.receiverId);
    }

    function isCallParticipantOnCreate() {
      return isSignedIn()
        && uid() == request.resource.data.callerId;
    }

    function onlyChangedKeys(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ─── Public identity indexes (pre-auth login / register / recovery) ────
    // Contain ONLY: uid, username, velixId, twoStepVerificationEnabled
    // Never store vault / recovery hash / TOTP here.

    match /usernames/{usernameKey} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'velixId', 'twoStepVerificationEnabled'
        ])
        && !('passwordVault' in request.resource.data)
        && !('recoverySecurityKey' in request.resource.data)
        && !('totpSecret' in request.resource.data);
      allow update: if isSignedIn()
        && resource.data.uid == uid()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'velixId', 'twoStepVerificationEnabled'
        ]);
      allow delete: if isSignedIn() && resource.data.uid == uid();
    }

    match /velix_ids/{velixIdKey} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'velixId', 'twoStepVerificationEnabled'
        ]);
      allow update: if isSignedIn()
        && resource.data.uid == uid()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'velixId', 'twoStepVerificationEnabled'
        ]);
      allow delete: if isSignedIn() && resource.data.uid == uid();
    }

    // ─── Users ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Authenticated profile reads (friends, discovery, QR, presence).
      // Unauthenticated list/get denied — use usernames/velix_ids indexes.
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && !hasForbiddenUserSecrets();

      allow update: if isOwner(userId)
        && !hasForbiddenUserSecrets()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.velixId == resource.data.velixId
        && (
          !('velixIdLower' in resource.data)
          || request.resource.data.velixIdLower == resource.data.velixIdLower
        );

      allow delete: if false;

      // Auth secrets — owner only. Unauthenticated recovery must use a
      // trusted backend (Cloud Functions), never a public Firestore get.
      match /security/credentials {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'recoverySecurityKey',
            'passwordVault',
            'totpSecret',
            'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      match /blocked/{blockedUid} {
        allow read: if isOwner(userId) || (isSignedIn() && uid() == blockedUid);
        allow create, update: if isOwner(userId)
          && request.resource.data.uid == blockedUid;
        allow delete: if isOwner(userId);
      }

      match /friends/{friendUid} {
        allow read: if isOwner(userId);
        // Bidirectional friendship writes (self + peer path).
        allow create: if isSignedIn()
          && (uid() == userId || uid() == friendUid)
          && request.resource.data.uid == friendUid;
        allow update: if isSignedIn()
          && (uid() == userId || uid() == friendUid);
        allow delete: if isSignedIn()
          && (uid() == userId || uid() == friendUid);
      }

      match /incomingFriendRequests/{fromUid} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn()
          && uid() == fromUid
          && request.resource.data.fromUid == fromUid
          && request.resource.data.toUid == userId;
        allow update: if false;
        allow delete: if isSignedIn()
          && (uid() == userId || uid() == fromUid);
      }

      match /outgoingFriendRequests/{toUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.fromUid == userId
          && request.resource.data.toUid == toUid;
        allow update: if false;
        allow delete: if isSignedIn()
          && (uid() == userId || uid() == toUid);
      }

      match /call_history/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isSignedIn()
          && (
            isOwner(userId)
            || uid() == request.resource.data.callerId
            || uid() == request.resource.data.receiverId
          );
        allow delete: if isOwner(userId);
      }
    }

    // ─── Conversations & messages ──────────────────────────────────────────

    match /conversations/{conversationId} {
      allow read: if isConversationParticipant();

      allow create: if isConversationParticipantOnCreate()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.keys().hasAll([
          'conversationKey', 'participants', 'createdAt'
        ]);

      allow update: if isConversationParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.conversationKey == resource.data.conversationKey;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipantOfConversation(conversationId);

        allow create: if isParticipantOfConversation(conversationId)
          && request.resource.data.senderId == uid()
          && request.resource.data.conversationId == conversationId
          && !isBlockedEitherWay(uid(), otherDmParticipant(conversationId));

        // Delivery/read receipts — participants may update status fields only.
        allow update: if isParticipantOfConversation(conversationId)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.conversationId == resource.data.conversationId
          && onlyChangedKeys([
            'status', 'deliveredAt', 'readAt', 'isEdited', 'isDeleted',
            'deletedFor', 'message', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }

    // ─── Calls & ICE ───────────────────────────────────────────────────────

    match /calls/{callId} {
      allow get: if isCallParticipant();
      // Incoming ringing query: where receiverId == auth.uid
      allow list: if isSignedIn()
        && resource.data.receiverId == uid();

      allow create: if isCallParticipantOnCreate()
        && request.resource.data.callerId == uid()
        && request.resource.data.keys().hasAll([
          'callerId', 'receiverId', 'status', 'conversationId'
        ])
        && !isBlockedEitherWay(
          request.resource.data.callerId,
          request.resource.data.receiverId
        );

      allow update: if isCallParticipant()
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.receiverId == resource.data.receiverId;

      allow delete: if false;

      match /iceCandidates/{candidateId} {
        allow read: if isSignedIn()
          && (
            uid() == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
            || uid() == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId
          );

        allow create: if isSignedIn()
          && request.resource.data.fromUserId == uid()
          && (
            uid() == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
            || uid() == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId
          );

        allow update, delete: if false;
      }
    }

    // ─── Time capsules (stories) ───────────────────────────────────────────
    // Current client queries all non-expired stories then filters friends
    // client-side. Tightening to friends-only would break that query model.

    match /time_capsules/{storyId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == uid();

      allow update: if isSignedIn()
        && (
          resource.data.ownerId == uid()
          || onlyChangedKeys(['viewers', 'seenBy', 'likes'])
        );

      allow delete: if isSignedIn()
        && resource.data.ownerId == uid();
    }

    // ─── Support ───────────────────────────────────────────────────────────

    match /support_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.keys().hasAll(['userId', 'type', 'message', 'status']);
      allow read, update, delete: if false;
    }
  }
}
